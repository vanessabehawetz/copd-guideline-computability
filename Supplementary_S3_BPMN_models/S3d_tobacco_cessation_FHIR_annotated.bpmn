      <bpmn:text>FHIR input:
Patient
Condition: COPD
Observation: current smoking status</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1abcb2l">
      <bpmn:text>FHIR ActivityDefinition:
Brief cessation counseling

FHIR Procedure:
Counseling performed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0xrrc5t">
      <bpmn:text>FHIR input:
Observation / QuestionnaireResponse
motivation_level

Modeling gap:
No explicit cut-off in guideline</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18bxcu4">
      <bpmn:text>FHIR ActivityDefinition:
Motivational interviewing</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_01205vm">
      <bpmn:text>EBMonFHIR:
Recommendation 3-3
Strength: strong
Basis: expert consensus / indirect evidence</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0oi2zuh">
      <bpmn:text>FHIR input:
Consent.status
consent_to_therapy = true/false</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_19umb2n">
      <bpmn:text>FHIR CarePlan:
Combined smoking cessation therapy</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0w246vq">
      <bpmn:text>FHIR ServiceRequest:
Behavioral therapy</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_195dvfc">
      <bpmn:text>FHIR MedicationRequest:
Pharmacotherapy for withdrawal symptoms</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ohrtzj">
      <bpmn:text>EBMonFHIR:
Recommendation 3-4
Strength: strong
Evidence: systematic review / Cochrane Review
Outcome: prolonged abstinence</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0mqwg19">
      <bpmn:text>FHIR timing:
CarePlan.period
PlanDefinition.action.timing

Modeling gap:
Follow-up interval not explicitly specified in algorithm</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ae9aal">
      <bpmn:text>FHIR input:
Observation.abstinence_status</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0dl8uw6">
      <bpmn:text>Modeling gap:
